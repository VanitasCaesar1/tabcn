{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "customConditions": ["tabcn-source"],
    "paths": {
      "@/*": ["./src/*"],
      "@registry/*": ["../../registry/designs/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../registry/designs/ask-dock/*.tsx"
  ]
}
