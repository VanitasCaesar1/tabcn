{
  "name": "react-native-tabcn",
  "version": "0.3.0",
  "description": "Animated, copy-and-own tab bars for React Native and Expo.",
  "license": "MIT",
  "homepage": "https://vanitascaesar1.github.io/tabcn/",
  "bugs": {
    "url": "https://github.com/VanitasCaesar1/tabcn/issues"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-router",
    "react-navigation",
    "tab-bar",
    "tabbar",
    "bottom-tabs",
    "reanimated"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VanitasCaesar1/tabcn.git",
    "directory": "packages/tabcn"
  },
  "sideEffects": false,
  "tabcn-source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "tabcn-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./expo-router": {
      "tabcn-source": "./src/expo-router.tsx",
      "types": "./lib/typescript/src/expo-router.d.ts",
      "default": "./lib/module/expo-router.js"
    },
    "./react-navigation": {
      "tabcn-source": "./src/react-navigation.tsx",
      "types": "./lib/typescript/src/react-navigation.d.ts",
      "default": "./lib/module/react-navigation.js"
    },
    "./gestures": {
      "tabcn-source": "./src/gestures.tsx",
      "types": "./lib/typescript/src/gestures.d.ts",
      "default": "./lib/module/gestures.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "prepack": "bob build",
    "test": "jest"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.81",
    "react-native-reanimated": ">=4",
    "expo-router": ">=58",
    "@react-navigation/bottom-tabs": ">=7",
    "@react-navigation/native": ">=7",
    "react-native-gesture-handler": ">=2",
    "react-native-safe-area-context": ">=4"
  },
  "devDependencies": {
    "@react-navigation/bottom-tabs": "7.22.0",
    "@react-navigation/native": "7.5.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "expo": "~58.0.26",
    "expo-router": "~58.0.32",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "expo-router": {
      "optional": true
    },
    "@react-navigation/bottom-tabs": {
      "optional": true
    },
    "@react-navigation/native": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest/setup.js"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^react-native-reanimated$": "<rootDir>/jest/reanimated.js",
      "^react-native-reanimated/mock$": "<rootDir>/jest/reanimated-impl.js",
      "^react-native-tabcn$": "<rootDir>/src/index.ts",
      "^react-native-tabcn/gestures$": "<rootDir>/src/gestures.tsx"
    }
  }
}
